# Supabase → Project Settings → API → Project URL
SUPABASE_URL=
# Supabase → Settings → API Keys → Secret key (только на сервере)
SUPABASE_SECRET_KEY=
# Создать у @BotFather в Telegram, не присылать в чат
TELEGRAM_BOT_TOKEN=
# После Start у бота: npm run telegram:chat-id
TELEGRAM_CHAT_ID=
# Юридическое имя оператора и контакт для запросов о персональных данных
PRIVACY_OPERATOR=
PRIVACY_CONTACT=
# true только после настройки базы, проверки политики и тестовой заявки
LEADS_ENABLED=false
# Полный реальный HTTPS-адрес после выбора домена, без завершающего слеша
SITE_URL=
